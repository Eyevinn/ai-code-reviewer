{
  "name": "ai_code_reviewer",
  "version": "1.0.0",
  "description": "Backend to provide application configuration",
  "scripts": {
    "test": "jest",
    "prepare": "husky",
    "lint": "eslint .",
    "pretty": "prettier --check --ignore-unknown .",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "dev": "nodemon",
    "dev:app": "NODE_OPTIONS='--inspect' NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1 next dev",
    "build:app": "next build --webpack",
    "start": "ts-node -T src/server.ts",
    "postversion": "git push && git push --tags"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@heroui/react": "^2.6.14",
    "@sinclair/typebox": "^0.34.52",
    "@tabler/icons-react": "^3.19.0",
    "fastify": "^5.12.1",
    "next": "^16.3.3",
    "nodemon": "^3.1.7",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@heroui/theme": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.16",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
